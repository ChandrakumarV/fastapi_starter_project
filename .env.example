# Application
PROJECT_NAME="FastAPI Starter Project"
VERSION="1.0.0"
DESCRIPTION="Production-grade FastAPI Starter Application"
ENVIRONMENT="development"
DEBUG=true

# API
API_V1_STR="/api/v1"

# Database (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="root"
POSTGRES_PASSWORD="root"
POSTGRES_DB="postgres"

# Security & JWT
# In production, generate a secure secret: `openssl rand -hex 32`
SECRET_KEY="development-super-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Cookie Configuration
COOKIE_NAME="access_token"
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]
